rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'youssefeslam906@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin();
    }

    function isValidGroup(g) {
      return g in ['A', 'B', 'C', 'D'];
    }

    // 3. Validation Blueprints
    function isValidTeam(data, teamId) {
      return data.keys().hasAll(['id', 'name', 'group', 'players', 'paid', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['id', 'name', 'group', 'players', 'paid', 'qualified', 'status', 'ownerUid', 'createdAt']) &&
        data.id == teamId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 30 &&
        isValidGroup(data.group) &&
        data.players is list && data.players.size() >= 5 && data.players.size() <= 8 &&
        data.players[0] is string && data.players[0].size() >= 1 && data.players[0].size() <= 30 &&
        data.paid is bool &&
        (!('qualified' in data) || data.qualified is bool) &&
        (!('status' in data) || data.status in ['pending', 'approved']) &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp;
    }

    function isValidTeamContact(data, teamId) {
      return data.keys().hasAll(['teamId', 'ownerUid', 'phone', 'ref', 'createdAt']) &&
        data.keys().hasOnly(['teamId', 'ownerUid', 'phone', 'ref', 'createdAt']) &&
        data.teamId == teamId &&
        isValidId(data.ownerUid) &&
        data.phone is string && data.phone.size() == 11 && data.phone.matches('^01[0125][0-9]{8}$') &&
        data.ref is string && data.ref.size() <= 30 &&
        data.createdAt is timestamp;
    }

    function isValidScore(val) {
      return val == null || (val is int && val >= 0 && val <= 99);
    }

    function isValidMatch(data, matchId) {
      return data.keys().hasAll(['id', 'group', 'homeTeamId', 'awayTeamId', 'date', 'time', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'group', 'homeTeamId', 'awayTeamId', 'hs', 'aw', 'date', 'time', 'updatedAt']) &&
        data.id == matchId &&
        matchId.matches('^[A-D]_[a-zA-Z0-9_\\-]+_[a-zA-Z0-9_\\-]+$') &&
        isValidGroup(data.group) &&
        isValidId(data.homeTeamId) &&
        isValidId(data.awayTeamId) &&
        data.homeTeamId != data.awayTeamId &&
        (!('hs' in data) || isValidScore(data.hs)) &&
        (!('aw' in data) || isValidScore(data.aw)) &&
        data.date is string && data.date.size() <= 30 &&
        data.time is string && data.time.size() <= 20 &&
        data.updatedAt is timestamp;
    }

    function isValidKnockoutMatch(data, matchId) {
      return data.keys().hasAll(['id', 'round', 'label', 'homeName', 'awayName', 'date', 'time', 'winnerName', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'round', 'label', 'homeName', 'awayName', 'hs', 'aw', 'date', 'time', 'winnerName', 'updatedAt']) &&
        data.id == matchId &&
        matchId in ['QF1', 'QF2', 'QF3', 'QF4', 'SF1', 'SF2', 'FINAL'] &&
        data.round in ['QF', 'SF', 'FINAL'] &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 30 &&
        data.homeName is string && data.homeName.size() <= 30 &&
        data.awayName is string && data.awayName.size() <= 30 &&
        (!('hs' in data) || isValidScore(data.hs)) &&
        (!('aw' in data) || isValidScore(data.aw)) &&
        data.date is string && data.date.size() <= 30 &&
        data.time is string && data.time.size() <= 20 &&
        data.winnerName is string && data.winnerName.size() <= 30 &&
        data.updatedAt is timestamp;
    }

    function isValidScorer(data, scorerId) {
      return data.keys().hasAll(['id', 'playerName', 'teamName', 'goals', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'playerName', 'teamName', 'goals', 'updatedAt']) &&
        data.id == scorerId &&
        data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 30 &&
        data.teamName is string && data.teamName.size() >= 1 && data.teamName.size() <= 30 &&
        data.goals is int && data.goals >= 0 && data.goals <= 999 &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    // Public tournament roster (zero PII)
    match /teams/{teamId} {
      allow get: if isValidId(teamId);
      allow list: if true;

      allow create: if isVerified() &&
        isValidId(teamId) &&
        isValidTeam(incoming(), teamId) &&
        incoming().ownerUid == request.auth.uid &&
        (isAdmin() || (incoming().paid == false && (!('status' in incoming()) || incoming().status == 'pending'))) &&
        (!('qualified' in incoming()) || incoming().qualified == false) &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/team_contacts/$(teamId));

      allow update: if isVerified() &&
        isValidId(teamId) &&
        isValidTeam(incoming(), teamId) &&
        incoming().id == existing().id &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['group', 'paid', 'qualified', 'status', 'name', 'players']);

      allow delete: if isValidId(teamId) && isAdmin();
    }

    // Isolated PII collection (captain phone + InstaPay ref)
    match /team_contacts/{teamId} {
      allow get: if isValidId(teamId) && (
        isAdmin() || (isVerified() && existing().ownerUid == request.auth.uid)
      );

      allow list: if isBootstrappedAdmin() || (
        isVerified() && resource.data.ownerUid == request.auth.uid
      );

      allow create: if isVerified() &&
        isValidId(teamId) &&
        isValidTeamContact(incoming(), teamId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/teams/$(teamId)) &&
        getAfter(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid;

      allow update: if isVerified() &&
        isValidId(teamId) &&
        isValidTeamContact(incoming(), teamId) &&
        incoming().teamId == existing().teamId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        (isAdmin() || existing().ownerUid == request.auth.uid) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'ref']);

      allow delete: if isValidId(teamId) && isAdmin();
    }

    // Public group stage matches & scores
    match /matches/{matchId} {
      allow get: if isValidId(matchId);
      allow list: if true;

      allow create: if isValidId(matchId) &&
        isAdmin() &&
        isValidMatch(incoming(), matchId) &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/teams/$(incoming().homeTeamId)) &&
        exists(/databases/$(database)/documents/teams/$(incoming().awayTeamId));

      allow update: if isValidId(matchId) &&
        isAdmin() &&
        isValidMatch(incoming(), matchId) &&
        incoming().id == existing().id &&
        incoming().group == existing().group &&
        incoming().homeTeamId == existing().homeTeamId &&
        incoming().awayTeamId == existing().awayTeamId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['hs', 'aw', 'date', 'time', 'updatedAt']);

      allow delete: if isValidId(matchId) && isAdmin();
    }

    // Public knockout bracket & matches (admin-only writes)
    match /knockout_matches/{matchId} {
      allow get: if isValidId(matchId);
      allow list: if true;

      allow create: if isValidId(matchId) &&
        isAdmin() &&
        isValidKnockoutMatch(incoming(), matchId) &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(matchId) &&
        isAdmin() &&
        isValidKnockoutMatch(incoming(), matchId) &&
        incoming().id == existing().id &&
        incoming().round == existing().round &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['label', 'homeName', 'awayName', 'hs', 'aw', 'date', 'time', 'winnerName', 'updatedAt']);

      allow delete: if isValidId(matchId) && isAdmin();
    }

    // Public top scorers leaderboard (admin-only writes)
    match /scorers/{scorerId} {
      allow get: if isValidId(scorerId);
      allow list: if true;

      allow create: if isValidId(scorerId) &&
        isAdmin() &&
        isValidScorer(incoming(), scorerId) &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(scorerId) &&
        isAdmin() &&
        isValidScorer(incoming(), scorerId) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['playerName', 'teamName', 'goals', 'updatedAt']);

      allow delete: if isValidId(scorerId) && isAdmin();
    }

    // Admin registry (locked strictly to bootstrapped owner)
    match /admins/{uid} {
      allow get: if isValidId(uid) && isBootstrappedAdmin();
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if false;
    }
  }
}
